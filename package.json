{
  "name": "auto-research-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "research-loop": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean_runtime.mjs && tsc && tsc -p tsconfig.browser.json && node scripts/build_dashboard.mjs",
    "test": "npm run build && node --test dist/tests/runtime/*.test.js",
    "research": "node dist/src/cli.js",
    "check": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "dashboard": "node dist/src/cli.js dashboard",
    "web": "node dist/src/cli.js web"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.8.0"
  }
}
